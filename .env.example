# DeepAgents Scaffold - Environment Variables
# Copy this file to .env and fill in your API keys.

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek
DEEPSEEK_API_KEY=sk-...

# Moonshot / Kimi
MOONSHOT_API_KEY=sk-...

# LangSmith Tracing (optional)
LANGCHAIN_API_KEY=ls-...
LANGSMITH_TRACING=false

# Langfuse Tracing (optional)
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING=false

# Feishu / Lark (optional)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Slack (optional)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Optional: API key for simple auth
# API_KEY=your-secret-api-key

# 多用户认证 token（config.yaml auth 段引用；自行替换为随机强 token）
SCAFFOLD_TOKEN_ALICE=change-me-alice
SCAFFOLD_TOKEN_BOB=change-me-bob
