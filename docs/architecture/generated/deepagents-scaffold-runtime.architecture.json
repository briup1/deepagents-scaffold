  "cards": [
    {
      "dot": "cyan",
      "title": "Primary request path",
      "items": [
        "CopilotKit sends thread-scoped runs to /agent/{name}; FastAPI streams AG-UI events back to the browser.",
        "The selected compiled graph invokes a configured model provider and can emit generative UI actions."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and isolation",
      "items": [
        "Ingress layers provide optional API-key authentication, IP rate limiting, request IDs, logging, and normalized errors.",
        "Generated extraction code runs in a subprocess with AST checks, an import allowlist, and a timeout; the ADR marks this as an MVP boundary."
      ]
    },
    {
      "dot": "emerald",
      "title": "Durability and extension",
      "items": [
        "SQLite persists LangGraph checkpoints, thread history, extraction tasks, and artifact metadata; files remain session-scoped on the host filesystem.",
        "YAML configuration assembles models, middleware, profiles, skills, tools, subagents, channels, and optional tracing providers."
      ]
    }
  ]
