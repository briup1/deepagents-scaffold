{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Run Agent Directly",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug_agent.py",
      "args": [
        "--message",
        "hello"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "src"
      },
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      "name": "Debug: FastAPI Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "scaffold.api.app:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "src"
      },
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    }
  ]
}
